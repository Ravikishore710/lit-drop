# Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Storage
DATA_DIR=./data
OBJECT_STORE_TYPE=filesystem
OBJECT_STORE_LOCAL_DIR=./data/raw

# Vector Database (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=scientific_docs_chunks
QDRANT_USE_SQ8=true

# Graph Database (Neo4j)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=scientific_docintel_secret
NEO4J_DATABASE=neo4j

# LLM Providers
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
GEMINI_API_KEY=your_gemini_api_key_here

# Local LLM Fallback (e.g., DeepSeek-R1-Distill-Qwen-1.5B / llama.cpp / Ollama)
LOCAL_LLM_ENABLED=false
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=deepseek-r1:1.5b

# Embeddings
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu

# Reranker
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_DEVICE=cpu

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]
