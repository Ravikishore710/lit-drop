{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CanonicalDocumentRecord",
  "description": "Unified machine-readable schema for parsed scientific documents and their multimodal elements",
  "type": "object",
  "required": [
    "document_id",
    "metadata",
    "pages",
    "elements",
    "schema_version",
    "parser_version"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "parser_version": {
      "type": "string"
    },
    "document_id": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "metadata": {
      "type": "object",
      "required": [
        "document_id",
        "source",
        "title",
        "authors",
        "abstract",
        "file_sha256",
        "file_size_bytes",
        "page_count",
        "ingestion_timestamp",
        "processing_status"
      ],
      "properties": {
        "document_id": { "type": "string" },
        "source": { "type": "string" },
        "source_url": { "type": "string" },
        "title": { "type": "string" },
        "authors": {
          "type": "array",
          "items": { "type": "string" }
        },
        "abstract": { "type": "string" },
        "publication_date": { "type": ["string", "null"] },
        "categories": {
          "type": "array",
          "items": { "type": "string" }
        },
        "doi": { "type": ["string", "null"] },
        "arxiv_id": { "type": ["string", "null"] },
        "version": { "type": ["string", "null"] },
        "original_filename": { "type": "string" },
        "file_sha256": { "type": "string" },
        "file_size_bytes": { "type": "integer" },
        "page_count": { "type": "integer" },
        "ingestion_timestamp": { "type": "string", "format": "date-time" },
        "parser_version": { "type": "string" },
        "processing_status": {
          "type": "string",
          "enum": ["UPLOADED", "VALIDATING", "PROCESSING", "INDEXING", "READY", "FAILED"]
        }
      }
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "document_id",
          "page_id",
          "page_number",
          "width",
          "height",
          "rendered_image_path",
          "extraction_status"
        ],
        "properties": {
          "document_id": { "type": "string" },
          "page_id": { "type": "string" },
          "page_number": { "type": "integer", "minimum": 1 },
          "width": { "type": "number" },
          "height": { "type": "number" },
          "dpi": { "type": "integer", "default": 150 },
          "rendered_image_path": { "type": "string" },
          "extraction_status": {
            "type": "string",
            "enum": ["SUCCESS", "PARTIAL", "FAILED"]
          }
        }
      }
    },
    "elements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "element_id",
          "document_id",
          "page_id",
          "page_number",
          "element_type",
          "bounding_box",
          "reading_order",
          "normalized_content"
        ],
        "properties": {
          "element_id": { "type": "string" },
          "document_id": { "type": "string" },
          "page_id": { "type": "string" },
          "page_number": { "type": "integer", "minimum": 1 },
          "element_type": {
            "type": "string",
            "enum": [
              "title",
              "section_heading",
              "paragraph",
              "list",
              "table",
              "figure",
              "chart",
              "equation",
              "caption",
              "reference",
              "header",
              "footer"
            ]
          },
          "bounding_box": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 4,
            "maxItems": 4,
            "description": "[x0, y0, x1, y1] coordinates normalized to page dimensions"
          },
          "reading_order": { "type": "integer" },
          "parent_section_id": { "type": ["string", "null"] },
          "previous_element_id": { "type": ["string", "null"] },
          "next_element_id": { "type": ["string", "null"] },
          "raw_content_reference": { "type": ["string", "null"] },
          "normalized_content": { "type": "string" },
          "structured_data": {
            "type": ["object", "null"],
            "description": "Optional structured table rows/cols, chart series, or LaTeX equation strings"
          },
          "extraction_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "parser_version": { "type": "string" }
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "target_id", "relation_type"],
        "properties": {
          "source_id": { "type": "string" },
          "target_id": { "type": "string" },
          "relation_type": {
            "type": "string",
            "enum": [
              "HAS_PAGE",
              "HAS_SECTION",
              "HAS_ELEMENT",
              "AUTHORED_BY",
              "CITES",
              "CONTAINS_TABLE",
              "CONTAINS_FIGURE",
              "CONTAINS_EQUATION",
              "ASSOCIATED_WITH_CAPTION",
              "MENTIONS_ENTITY"
            ]
          },
          "metadata": { "type": "object" }
        }
      }
    }
  }
}
